# Initial map source: auto, cesium, tianditu, or local.
# auto preserves the first available source in this order: Cesium, Tianditu, local fallback.
VITE_MAP_SOURCE=auto

# Optional public-client token for Cesium ion online global imagery and city-name geocoding.
# Keep the public `geocode` scope enabled if you want the local editor to search cities through ion.
# Leave empty to use the bundled low-resolution Natural Earth II fallback.
# Every person who deploys StarMap supplies an app-specific token from their own ion account.
# For personal mode, copy this file to 06_private/config/.env.local outside the source repository.
# In the official maintenance workspace that path is StarMap/06_private/config/.env.local.
# Never commit, document, or paste a real token into chat.
VITE_CESIUM_ION_TOKEN=

# Optional public-client key for Tianditu imagery and Chinese annotation tiles.
# Apply for your own key at https://lbs.tianditu.gov.cn/ and restrict production use in its console.
VITE_TIANDITU_TOKEN=

# Optional: personal mode loads the private layer; public mode always uses the neutral sample.
VITE_TRAVEL_ATLAS_DATA_MODE=local

# Optional override for forks, in owner/repository format.
# The official build defaults to Aisland-SJL/StarMap and checks its latest Release at most twice per day.
VITE_GITHUB_REPOSITORY=Aisland-SJL/StarMap
